{
  "name": "GraphQL meets PostGIS: a spatial API workshop",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "forwardPorts": [5001, 5050, 5002],
  "portsAttributes": {
    "5001": { "label": "GraphiQL (PostGraphile)" },
    "5050": { "label": "pgAdmin" },
    "5002": { "label": "Finished workshop (optional)" }
  },
  "postStartCommand": "until docker info >/dev/null 2>&1; do sleep 1; done; docker compose up -d"
}
