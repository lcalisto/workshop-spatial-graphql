# Copy this file to .env (in this same folder) and set your own values.
# The .env file itself is gitignored and must never be committed.

# DB
# Parameters used by the db container
POSTGRES_DB=workshop_graphql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# GRAPHQL
# Parameters used by the graphql container.
# The app_postgraphile role is created during the workshop (README section 8);
# the password here must match the one you use in that SQL.
DATABASE_URL=postgres://app_postgraphile:change_me@host.docker.internal/workshop_graphql
